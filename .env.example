OPENAI_API_KEY=your-openai-api-key
SONARR_API_KEY=your-sonarr-api-key
RADARR_API_KEY=your-radarr-api-key
# Set to off to disable the one-time anonymous install telemetry event.
SUBTITLER_TELEMETRY=
# Optional private-build override. Leave empty to use the built-in maintainer DSN.
SENTRY_DSN=
PUID=1000
PGID=1000
